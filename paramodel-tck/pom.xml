<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.nosqlbench</groupId>
        <artifactId>paramodel-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>paramodel-tck</artifactId>
    <name>Paramodel TCK</name>
    <description>Technology Compatibility Kit for Paramodel API implementations</description>

    <properties>
        <jacoco.instruction.minimum>0.95</jacoco.instruction.minimum>
        <jacoco.line.minimum>0.95</jacoco.line.minimum>
        <jacoco.method.minimum>0.90</jacoco.method.minimum>
    </properties>

    <dependencies>
        <!-- API Contracts -->
        <dependency>
            <groupId>io.nosqlbench</groupId>
            <artifactId>paramodel-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- JUnit 5 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- AssertJ -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- Engine implementation to verify -->
        <dependency>
            <groupId>io.nosqlbench</groupId>
            <artifactId>paramodel-engine</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Mock implementation for TCK validation -->
        <dependency>
            <groupId>io.nosqlbench</groupId>
            <artifactId>paramodel-mock</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>aggregate-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <title>Paramodel Aggregate Coverage</title>
                            <outputDirectory>${project.reporting.outputDirectory}/jacoco-aggregate</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
